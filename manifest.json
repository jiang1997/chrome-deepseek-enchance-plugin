{
  "manifest_version": 3,
  "name": "DeepSeek Enhancer",
  "version": "0.1.1",
  "description": "Select text in a DeepSeek response and quote it into the composer to keep asking (runs locally, uploads nothing).",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "minimum_chrome_version": "116",
  "content_scripts": [
    {
      "matches": ["https://chat.deepseek.com/*"],
      "js": ["src/content.ts"],
      "css": ["src/styles/popup.css"],
      "run_at": "document_idle"
    }
  ]
}
